{
  "name": "apple-debug-mcp",
  "version": "0.4.0",
  "description": "MCP debug daemon for Apple Simulators: pool state, tool-agnostic session leases, wait queue with auto-dispatch. Built on simslim (lifecycle) + AXe (UI automation).",
  "type": "module",
  "bin": {
    "apple-debug-mcp": "./dist/index.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "eval:baseline": "node dist/eval-cli.js --dataset data/eval/v1",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devyhan/apple-debug-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/devyhan/apple-debug-mcp/issues"
  },
  "homepage": "https://github.com/devyhan/apple-debug-mcp#readme",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "apple",
    "ios-simulator",
    "xcode",
    "simctl",
    "ui-automation",
    "debugging"
  ],
  "author": "devyhan",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.7.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
